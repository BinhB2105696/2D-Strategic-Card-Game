# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory captures
MemoryCaptures/

# Asset metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Visual Studio / Rider
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# OS generated files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt

# Unity cache / generated files
*.pidb
*.pdb
*.mdb
*.opendb

# Build outputs
*.apk
*.aab
*.unitypackage

# Addressables
ServerData/

# User-specific project settings
UserSettings/

# JetBrains Rider
*.sln.iml

# Coverage
/[Cc]overage/

# Test results
/[Tt]est[Rr]esults/

# Autogenerated VS/IDE files
ExportedObj/
.consulo/

# --- Bổ sung thêm cho dự án Luận văn ---

# Chặn file tạm sinh ra khi biên dịch code Android (vì có chọn Android Build Support)
.gradle/
/local.properties

# Headless simulation output and local build/run control
/SimulationResults/
/Tools/Simulation/Control/
/Tools/Simulation/editor-request.txt
/Tools/Simulation/build-status.json

# Chặn các file rác phát sinh từ thư mục Packages (chỉ giữ lại manifest để Unity tự tải ngầm)
/Packages/manifest.json.lock
/Packages/packages-lock.json

# Chặn file tạm của TextMeshPro (công cụ làm chữ font UI đẹp trong Unity, chắc chắn sẽ dùng)
/[Aa]ssets/[Tt]ext[Mm]esh [Pp]ro/

# Chặn file sao lưu tự động của các phần mềm vẽ/thiết kế nếu bạn để chung trong thư mục Assets
*.bak
*.tmp
